# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/minigame

# JWT
JWT_SECRET=your-super-secret-key-change-this

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth (Apple)
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# OAuth (Kakao)
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# [CTR] CatchTheRule 소유 — 아래 CTR_* 키 삭제 금지 (리포 루트 CLAUDE.md)
# CatchTheRule 인앱결제 영수증 검증
# Android: Play Console > 수익 창출 설정 > 라이선스 의 base64 RSA 공개키 (Android 검증 필수)
CTR_PLAY_PUBLIC_KEY=
# iOS(선택): Apple Root CA - G3 인증서 SHA-256 지문(콜론/공백 무관). 설정 시 루트 핀닝으로 검증 강화
CTR_APPLE_ROOT_SHA256=

# [MFA] 성인의 수학 소셜 로그인 검증 (선택적 로그인)
# Google: 허용할 OAuth client_id(audience) 콤마 구분 (android/ios/web)
MFA_GOOGLE_CLIENT_IDS=
# Apple: identityToken audience = iOS 번들 ID (필요시 Service ID 추가, 콤마 구분)
MFA_APPLE_BUNDLE_IDS=com.jiny.mathForAdults

# [PP] PerlerPixel(비즈픽셀) 커뮤니티 — 별도 리포(PerlerPixel) 소유. 소셜 로그인 검증용.
PP_GOOGLE_CLIENT_IDS=
PP_APPLE_BUNDLE_IDS=com.jiny.bizpixel
# [PP] 유니버설 링크(공유 링크가 앱을 열게) — Apple 팀ID.번들ID. 예: ABCDE12345.com.jiny.bizpixel
# Xcode > Signing & Capabilities 의 Team ID로 채워야 링크가 앱을 가로챕니다. 비우면 웹 폴백만 동작.
PP_APPLE_APP_ID=

# [PP] 비즈픽셀 푸시(FCM HTTP v1) — 서비스 계정 JSON에서. 미설정 시 푸시는 no-op.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
